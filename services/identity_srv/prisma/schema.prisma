// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

generator prismaClassGenerator {
  provider = "prisma-class-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  uuid             String @id @default(uuid(4)) @db.Uuid

  device           String
  fingerprint      String
  isRevoked        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userUuid         String @db.Uuid
  user             User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  refreshToken     RefreshToken?

  @@map("session")
}

model RefreshToken {
  uuid           String @id @default(uuid()) @db.Uuid

  token          String @unique
  expiresAt      DateTime

  isRevoked      Boolean @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessionUuid    String @unique @db.Uuid
  session        Session @relation(fields: [sessionUuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@index([uuid])
  @@map("refresh_token")
}

model User {
  uuid      String   @id @default(uuid(4)) @db.Uuid
  login     String   @unique
  password  String?
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session    Session[]
  roles      Role[] @relation("role_on_user")
  persone    Person?

  @@index([uuid, login])
  @@map("user")
}

model Role {
  code        String @id @unique @db.VarChar(255)
  displayName String @unique

  users User[] @relation("role_on_user")
  permissions Permission[] @relation("permission_on_role")

  @@index([code])
  @@map("role")
}

model Permission {
  code        String @id @unique
  displayName String @unique

  roles Role[] @relation("permission_on_role")

  @@index([code])
  @@map("permission")
}

enum Sex {
  MALE
  FEMALE
}

model Person {
  uuid       String @id @default(uuid(4)) @db.Uuid
  userUuid   String @db.Uuid @unique

  name       String?
  surname    String?
  patronymic String?

  sex        Sex?
  birthday   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt() @default(now())

  user      User @relation(fields: [userUuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@index([userUuid])
  @@index([name, surname])
  @@index([birthday])

  @@map("persone")
}
