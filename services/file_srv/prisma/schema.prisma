// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output = "./client"
}

generator prismaClassGenerator {
  provider = "prisma-class-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  uuid  String @id @default(uuid()) @db.Uuid
  name  String @db.Text

  mime String @db.Text
  size Int    @db.Integer

  dir  Dir[] @relation("file_to_dir")

  @@index([uuid, name])
  @@map("file")
}

model Dir {
  uuid       String @id @default(uuid()) @db.Uuid
  name       String @db.Text

  parentUuid String? @db.Uuid
  parent     Dir? @relation(fields: [parentUuid], references: [uuid], name: "directory")
  children   Dir[] @relation("directory")

  files      File[] @relation("file_to_dir")

  @@index([uuid, name, parentUuid])
  @@map("dir")
}